Environment=DISPLAY=:0
ExecStartPre=/usr/bin/sleep 6
ExecStart=/usr/local/bin/vdrrun
#Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
#
echo "Enabling service..."
systemctl daemon-reload
#systemctl enable vdr
#systemctl start vdr
sleep 1
#
echo "                    Permissions to execute Vdr"
sleep 1
rm -rf /etc/sudoers.d/vdr
cat << EOF > /etc/sudoers.d/vdr

vdr ALL=(ALL) ALL
EOF
#
echo "$LOGNAME_USER ALL=NOPASSWD: /usr/bin/systemctl start vdr, /usr/bin/systemctl stop vdr, /usr/bin/systemctl restart vdr, /usr/local/bin/vdrpoweroff, /usr/bin/sudo /usr/sbin/poweroff -f" >> /etc/sudoers.d/vdr
#
chmod 0440 /etc/sudoers.d/vdr
echo "Permissions created"; sleep 1
#
echo "Create Fedora/Debian/Rpi systems commands"; sleep 1
rm -rf $BIN/systempoweroff
cat << EOF > $BIN/systempoweroff
#!/bin/sh
# File name: systempoweroff

/usr/bin/sudo /usr/bin/systemctl stop vdr
/usr/bin/sudo killall -9 vdr
sleep 2
/usr/bin/sudo /usr/sbin/poweroff
EOF
chmod a+x $BIN/systempoweroff
echo "Systempoweroff command installed"; sleep 1
#
echo "Installing Restart Vdr"; sleep 1
rm -rf $BIN/restart_vdr
cat << EOF > $BIN/restart_vdr
#!/bin/sh
# File name: restart_vdr

/usr/bin/sudo /usr/bin/systemctl stop vdr
/usr/bin/sudo /usr/bin/systemctl start vdr
EOF
chmod a+x $BIN/restart_vdr
echo "Restart Vdr command installed"; sleep 1
#
echo "                    Installing All Commands"
sleep 1
rm -rf $VDRCONF/commands.conf
cat << EOF > $VDRCONF/commands.conf
Kill Vdr: echo "/usr/local/bin/vdrpoweroff" | at now > /dev/null 2>&1
Restart Vdr: echo "/usr/local/bin/restart_vdr"  | at now > /dev/null 2>&1
Shutdown system: echo "/usr/local/bin/systempoweroff" | at now > /dev/null 2>&1
Restart system: sudo reboot > /dev/null 2>&1
EOF
echo "Commands installed"
sleep 1
#
cd /home/"$LOGNAME_USER"
chmod -R 777 Vdr_repo
chmod 777 /srv/vdr/video
;;
#
S) break
esac
done;;
G)
clear
while true; do
subch=$(whiptail --title "Desktop Os Final configuration" \
--menu "Use the arrows to navigate and Enter to select:" 20 70 10 \
           "a"  "Install Desktop commands & icons" \
           "S"  "Skip" \
        3>&1 1>&2 2>&3) || break

case $subch in
#
a)
clear
if grep -qiE 'arch|endeavouros' /etc/os-release; then
    echo "Endeavouros/Arch system: daemon AT enabled..."
    systemctl enable --now atd
fi
echo "                    Installing Icons"
sleep 1
if [ -f /usr/local/src/icone/vdr.png ]
then echo "Icons $Remind4"
sleep 1
else cd $SRC
cp -rf "$REPO/icone.tar.gz" "$SRC"
tar --no-xattrs -zxvf icone.tar.gz
rm -rf icone.tar.gz
cd icone
chmod 755 *
echo "Icons installed"; sleep 1
fi
#
echo "                    Create Vdr commands lines"
sleep 1
echo "Creating systemd service..."
sleep 1
#
. /etc/os-release
#
# Start & stop command Raspberry
if [ -f /proc/device-tree/model ] && grep -iq "raspberry" /proc/device-tree/model; then
    echo "Raspberry Pi found ..."; sleep 1

echo "Create Raspberry command line"; sleep 1
rm -rf $BIN/vdrrun
cat << EOF > $BIN/vdrrun
#!/bin/bash
#File name: vdrrun

sudo chvt 8  && sleep 2 && /usr/local/bin/vdr -u camper -t /dev/tty8 $PLUGINRPI -s $BIN/vdrpoweroff

# -a hw:CARD=sndrpihifiberry,0
# -a hw:CARD=BossDAC,0'EOF
EOF
chmod 755 $BIN/vdrrun
echo "Raspberry Start Vdr command created"; sleep 1
#
echo "Create Raspberry Stop Vdr"; sleep 1
rm -rf $BIN/vdrpoweroff
cat << EOF > $BIN/vdrpoweroff
#!/bin/sh
# File name: vdrpoweroff

sudo /usr/bin/systemctl stop vdr && killall -9 vdr && killall -9 vlc && chvt 7
EOF
chmod 755 $BIN/vdrpoweroff
echo "Raspberry Stop Vdr command created"; sleep 1

elif [[ "$ID" == "debian" || "$ID_LIKE" == *"debian"* || "$ID" == "ubuntu" || "$ID" == "endeavouros" || "$ID_LIKE" == *"arch"* || "$ID"  == "fedora" ]]; then

    echo "Fedora/Debian/Arch systems found..."; sleep 1

echo "Create Fedora/Debian/Arch systems command Start Vdr"; sleep 1
rm -rf $BIN/vdrrun
cat << EOF > $BIN/vdrrun
#!/bin/bash
#File name: vdrrun

/usr/local/bin/vdr -u root $PLUGIN -s $BIN/systempoweroff

## -P'mpv -a alsa -v gpu -h gpu -b / -l ita'
EOF
chmod 755 $BIN/vdrrun
echo "Start Vdr command created"; sleep 1
fi
#
. /etc/os-release

if [[ "$ID" == "debian" || "$ID_LIKE" == *"debian"* || "$ID" == "ubuntu" ]]; then

echo "Create Debian systems command Vdr Power off"; sleep 1
rm -rf $BIN/vdrpoweroff
cat << EOF > $BIN/vdrpoweroff
#!/bin/sh
# File name: vdrpoweroff

sudo systemctl stop vdr --timeout=2s 2>/dev/null || sudo killall -9 vdr 2>/dev/null
killall -9 vlc 2>/dev/null
EOF
chmod +x $BIN/vdrpoweroff
echo "Vdr Power off command created"; sleep 1

elif [[ "$ID" == "endeavouros" || "$ID_LIKE" == *"arch"* || "$ID"  == "fedora" ]]; then
   echo "Endeavourod/Arch/Fedora system found..."; sleep 1
echo "Create Endeavourod/Arch/Fedora systems command Vdr Power off"; sleep 1
rm -rf $BIN/vdrpoweroff
cat << EOF > $BIN/vdrpoweroff
#!/bin/sh
# File name: vdrpoweroff

sudo systemctl stop vdr --timeout=2s 2>/dev/null || sudo killall -9 vdr 2>/dev/null
killall -9 vlc 2>/dev/null
sleep 2
export XDG_RUNTIME_DIR=/run/user/1000
systemctl --user restart pipewire wireplumber
EOF
chmod +x $BIN/vdrpoweroff
echo "Vdr Power off command created"; sleep 1
fi
#
#
echo "                    Setup Vdr icons"
sleep 1
rm -f /usr/share/applications/Vdr.desktop
cat << 'EOF' > /usr/share/applications/Vdr.desktop
[Desktop Entry]
Version=1.0
Type=Application
Name=Start Vdr
Comment=Start of Vdr
Icon=/usr/local/src/icone/vdr.png
Exec=sudo systemctl start vdr
Terminal=false
EOF
chmod 755 /usr/share/applications/Vdr.desktop

#
rm -f /usr/share/applications/KillVdr.desktop
cat << 'EOF' > /usr/share/applications/KillVdr.desktop
[Desktop Entry]
Version=1.0
Type=Application
Name=Kill Vdr
Comment=Kill Vdr
Icon=/usr/local/src/icone/killvdr.png
Exec=/usr/local/bin/vdrpoweroff
Terminal=false
EOF
chmod 755 /usr/share/applications/KillVdr.desktop
echo "Vdr start & kill icons created"; sleep 1
#
ln -s /usr/local/bin/vdrrun /home/"$LOGNAME_USER"/vdrrun || { echo "Error ..."; true; }
chmod 777 /home/"$LOGNAME_USER"/vdrrun
#
clear
subch=$(whiptail --title "Vdr Automatic start" --menu "Select option:" 15 60 3 \
    "a" "Vdr auto start" \
    "b" "No auto start" \
    3>&1 1>&2 2>&3) || break
case $subch in
a)
clear
echo "                    Automatic start Vdr"
rm -rf vdr-autostart.desktop
systemctl enable vdr
whiptail --msgbox "Automatic start Vdr installed" 8 45 ;;
#
esac
#
echo "                    *** All things Done! ***"
sleep 3
whiptail --msgbox "Installation completed!" 8 45
break;;
#
S)
clear
break;;
esac
done;;
#
X)
clear
exit 0
;;
*) ;;
esac
done
