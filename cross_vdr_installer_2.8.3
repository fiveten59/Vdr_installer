    apt install -y "${DEBIANPACK[@]}" "${DEBIAN_FFMPEGPACK[@]}" "${DEBIAN_VDRLIB[@]}" "${DEBIAN_PLUGLIB[@]}" "${GM_PACKAGES[@]}"
    sleep 2
